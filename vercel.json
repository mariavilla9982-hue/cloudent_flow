{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/media_cleaner.py": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(manifest.webmanifest|cloudent-icon.svg|cloudent-notification-icon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
