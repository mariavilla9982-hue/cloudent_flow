{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/media_cleaner.py": {
      "maxDuration": 300
    },
    "api/virals.py": {
      "maxDuration": 60
    },
    "api/foryou-browser.js": {
      "maxDuration": 60
    },
    "api/foryou-worker-wake.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/foryou-worker-wake",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(manifest.webmanifest|cloudent-icon.svg|cloudent-notification-icon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/motion-control-production.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/motion-control-core-v6.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/motion-storage-ui.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
